{
  "name": "@gitpulse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --exclude \"../../packages/**/dist/**\" --exclude \"../../node_modules/**\" src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gitpulse/db": "workspace:*",
    "@gitpulse/ingestion": "workspace:*",
    "@gitpulse/parser": "workspace:*",
    "@gitpulse/queue": "workspace:*",
    "@gitpulse/retrieval": "workspace:*",
    "dotenv": "^16.6.1",
    "express": "^4.22.2",
    "ioredis": "^5.11.1",
    "openai": "^6.49.0",
    "pino": "^9.14.0",
    "prom-client": "^15.1.3",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "tsx": "^4.23.13"
  }
}
