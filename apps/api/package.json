{
  "name": "@gitpulse/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx watch --exclude \"../../packages/**/dist/**\" --exclude \"../../node_modules/**\" src/index.ts",
    "lint": "tsc -p tsconfig.json --noEmit",
    "start": "node dist/index.js",
    "test": "vitest run src",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@gitpulse/db": "workspace:*",
    "@gitpulse/ingestion": "workspace:*",
    "@gitpulse/parser": "workspace:*",
    "@gitpulse/queue": "workspace:*",
    "@gitpulse/retrieval": "workspace:*",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.10.1",
    "openai": "^6.34.0",
    "pino": "^9.6.0",
    "prom-client": "^15.1.3",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "vitest": "^4.1.5"
  }
}
