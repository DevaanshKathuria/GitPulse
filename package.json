{
  "name": "gitpulse",
  "private": true,
  "packageManager": "pnpm@9.15.4",
  "engines": {
    "node": ">=20 <24"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck && tsc -p tests/tsconfig.json",
    "pretest": "pnpm --filter @gitpulse/db build",
    "test": "tsx --test tests/**/*.test.ts",
    "eval": "pnpm --filter @gitpulse/api exec tsx src/eval/run-eval.ts"
  },
  "ts-node": {
    "esm": true,
    "experimentalResolver": true,
    "experimentalSpecifierResolution": "node"
  },
  "pnpm": {
    "overrides": {
      "@prisma/config>deepmerge-ts": "8.0.0",
      "qs": "6.16.0"
    }
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.13",
    "turbo": "^2.10.12",
    "typescript": "^5.9.3"
  }
}
